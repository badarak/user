
# Copy to .env and fill in the values. Never commit .env.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/users
DB_USERNAME=
DB_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# JWT (resource server)
# Public key: openssl genrsa -out jwt-private.pem 2048
#             openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
#             base64 < jwt-public.pem | tr -d '\n'
JWT_PUBLIC_KEY=
JWT_ISSUER=
JWT_AUDIENCE=user-api

# Dev only, read by scripts/generate-dev-token.sh. Never set it on a deployed environment.
# base64 < jwt-private.pem | tr -d '\n'
JWT_PRIVATE_KEY=

# CORS: comma-separated browser origins allowed to call the API (empty = none)
CORS_ALLOWED_ORIGINS=
